{
  "name": "nuxt",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "fmt": "npm run fmt:ox && npm run fmt:js",
    "fmt:check": "npm run fmt:check:ox",
    "fmt:ox": "oxfmt \"**/*.{vue,ts,tsx,json,jsonc,json5,yaml,yml,toml,html,css,scss,less,md,mdx}\"",
    "fmt:check:ox": "oxfmt --check \"**/*.{vue,ts,tsx,json,jsonc,json5,yaml,yml,toml,html,css,scss,less,md,mdx}\"",
    "fmt:js": "standard --fix \"**/*.{js,mjs,cjs,jsx}\"",
    "lint:js": "standard \"**/*.{js,mjs,cjs,jsx}\"",
    "lint:js:fix": "standard --fix \"**/*.{js,mjs,cjs,jsx}\"",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxtjs/i18n": "^10.2.0",
    "@pinia/nuxt": "^0.11.2",
    "@primeuix/themes": "^1.2.5",
    "@primevue/themes": "^4.4.1",
    "dayjs": "^1.11.19",
    "libphonenumber-js": "^1.12.27",
    "nuxt": "^4.1.2",
    "pinia": "^3.0.3",
    "primeicons": "^7.0.0",
    "primevue": "^4.4.1",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1",
    "vue-tel-input": "^9.5.0"
  },
  "devDependencies": {
    "@nuxt/image": "^1.11.0",
    "@nuxtjs/tailwindcss": "^6.14.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "oxfmt": "^0.41.0",
    "postcss": "^8.5.6",
    "pug": "^3.0.3",
    "standard": "^17.1.2",
    "tailwindcss": "^3.4.18"
  },
  "standard": {
    "env": {
      "browser": true,
      "node": true
    },
    "globals": [
      "defineNuxtPlugin",
      "useCookie",
      "useNuxtApp",
      "useRuntimeConfig",
      "navigateTo",
      "createError",
      "$fetch",
      "window",
      "localStorage",
      "process"
    ],
    "ignore": [
      "composables/useT.js"
    ]
  }
}
